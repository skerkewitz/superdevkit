# Doxygen's configuration for the console API's headers (lib/include/sdevkit): the HTML reference
# of what a game reaches, from the comments in the headers. Run from the repository's top folder:
#     doxygen lib/doxygen/Doxyfile
# It writes build/doxygen/html/index.html. Only the settings that differ from Doxygen's defaults.

PROJECT_NAME           = "superdevkit"
PROJECT_BRIEF          = "The console API: the SNES for a game in C"
PROJECT_NUMBER         = 0.9.2
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = lib/doxygen/mainpage.md lib/include/sdevkit
FILE_PATTERNS          = *.h
USE_MDFILE_AS_MAINPAGE = lib/doxygen/mainpage.md
OPTIMIZE_OUTPUT_FOR_C  = YES
FULL_PATH_NAMES        = NO
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
SORT_MEMBER_DOCS       = NO
SOURCE_BROWSER         = YES
VERBATIM_HEADERS       = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = LIGHT
SEARCHENGINE           = YES
